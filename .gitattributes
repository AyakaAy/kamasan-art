
# Default line ending
* text=auto eol=lf

# Source code
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Configuration and documentation
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary


/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
